QWidget {
    font-family: "Microsoft YaHei UI", sans-serif;
    color: #ffffff;
}

QWidget#voiceInputWindow, QFrame#fileDialogPanel {
    background: #202123;
    border-radius: 12px;
}

QFrame#fileDialogPanel {
    border: 1px solid #454649;
}

QLabel#fileDialogTitle {
    font-size: 15px;
    font-weight: 600;
}

QFrame#fileDialogPanel QLineEdit {
    background: #2c2d30;
    border: 1px solid #454649;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #505155;
}

QFrame#fileDialogPanel QLineEdit:focus {
    border-color: #777980;
}

QFrame#fileDialogPanel QLineEdit[invalid="true"] {
    border-color: #e46770;
}

QFrame#fileDialogPanel QPushButton {
    min-width: 64px;
    padding: 5px 10px;
    border: 1px solid transparent;
}

QFrame#fileDialogPanel QPushButton:focus,
QFrame#fileDialogPanel QPushButton:default {
    border-color: #777980;
}

QPushButton#confirmFileButton {
    background: #434447;
}

QPushButton#confirmFileButton:hover {
    background: #505155;
}

QPushButton#confirmFileButton:disabled {
    background: #2c2d30;
    color: #97999d;
    border-color: transparent;
}

QPushButton#deleteFileButton {
    background: #733b41;
}

QPushButton#deleteFileButton:hover {
    background: #894950;
}

QLabel#modelLoadError {
    color: #b2b2b2;
    font-size: 15px;
}

QComboBox, QComboBox QAbstractItemView {
    background: #2c2d30;
    color: #ffffff;
    border: 1px solid #454649;
    padding: 3px;
}

QComboBox:disabled {
    color: #97999d;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 34px;
}

QPlainTextEdit {
    background: #2c2d30;
    border: 1px solid #454649;
    border-radius: 8px;
    padding: 5px;
    font-size: 12px;
    placeholder-text-color: #808994;
}

QPlainTextEdit QMenu {
    color: #000000;
}

QWidget#transcriptSidebar {
    background: #2c2d30;
    border: 1px solid #454649;
    border-radius: 8px;
}

QListWidget#transcriptFiles {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#transcriptFiles::item:selected {
    background: #434447;
}

QMenu#transcriptFileMenu {
    color: #000000;
}

QPushButton {
    background: #343537;
    border: none;
    border-radius: 7px;
}

QPushButton#caption,
QPushButton:flat {
    background: transparent;
}

QPushButton:hover,
QPushButton#caption:hover {
    background: #434447;
}

QPushButton:pressed {
    background: #505155;
}
